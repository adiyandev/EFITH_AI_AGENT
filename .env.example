PORT=8787
HOST=0.0.0.0

# Add one or more provider keys. Keep these server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Frontend-only setting for local development.
# VITE_API_URL=http://localhost:8787

# MCP servers. Keep this local and do not commit real credentials.
# Example:
# MCP_SERVERS=[{"id":"my-server","name":"My MCP Server","transport":"streamable-http","url":"http://localhost:3000/mcp"}]
MCP_SERVERS=[]

# GitHub Remote MCP OAuth (backend only; never expose the secret to the browser)
# Create a GitHub OAuth App and register this exact callback URL.
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
GITHUB_MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/mcp/oauth/callback/github
EFITH_WEB_URL=http://localhost:5173/EFITH_AI_AGENT

# Google OAuth (backend only; never expose the secret to the browser)
# Register this exact callback URL in your Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/google/oauth/callback
